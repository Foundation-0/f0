[{"created": "2026-11-11T20:54:08.815587+00:00", "modified": "2026-11-11T20:54:09.089123+00:00", "id": 24146126, "conceptrecid": "24146125", "doi": "10.5281/zenodo.24146126", "conceptdoi": "10.5281/zenodo.24146125", "doi_url": "https://doi.org/10.5281/zenodo.24146126", "metadata": {"title": "gaia-dr4", "doi": "10.5281/zenodo.24146126", "publication_date": "2026-11-11", "description": "<p>This repository prepares to check earlier claims once Gaia's fourth data release (DR4) is out, on three questions: planets validated by machine learning alone, blends among the 665 TESS candidates of eumemic/exoplanets (as of 14 Oct 2026), and old eclipses of long-period DR4 binaries on the Harvard plates.</p><p>Status: preparing. No results yet.</p><p>The Gaia ESA Archive is scheduled to go down on Wednesday 25 November 2026, 12:00 CET, until DR4 is released on Wednesday 2 December 2026, about 12:00 CET.</p><p>Directed by Ahraz Arifuddin</p><p>Researched and verified by different model families across Gemini, Claude, Grok, OpenAI, and Muse</p>", "access_right": "open", "creators": [{"name": "Arifuddin, Ahraz", "affiliation": null}], "keywords": ["astronomy", "eclipsing-binaries", "exoplanets", "foundation0", "gaia", "tess"], "related_identifiers": [{"identifier": "https://github.com/Foundation-0/gaia-dr4", "relation": "isSupplementTo", "resource_type": "software", "scheme": "url"}], "version": "v1.0.0", "custom": {"code:codeRepository": "https://github.com/Foundation-0/gaia-dr4"}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "apache2.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "24146125"}}]}}, "title": "gaia-dr4", "links": {"self": "https://zenodo.org/api/records/24146126", "self_html": "https://zenodo.org/records/24146126", "preview_html": "https://zenodo.org/records/24146126?preview=1", "doi": "https://doi.org/10.5281/zenodo.24146126", "self_doi": "https://doi.org/10.5281/zenodo.24146126", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.24146126", "reserve_doi": "https://zenodo.org/api/records/24146126/draft/pids/doi", "parent": "https://zenodo.org/api/records/24146125", "parent_html": "https://zenodo.org/records/24146125", "parent_doi": "https://doi.org/10.5281/zenodo.24146125", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.24146125", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:24146126/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:24146126/sequence/default", "files": "https://zenodo.org/api/records/24146126/files", "media_files": "https://zenodo.org/api/records/24146126/media-files", "latest": "https://zenodo.org/api/records/24146126/versions/latest", "latest_html": "https://zenodo.org/records/24146126/latest", "versions": "https://zenodo.org/api/records/24146126/versions", "draft": "https://zenodo.org/api/records/24146126/draft", "access_links": "https://zenodo.org/api/records/24146126/access/links", "access_grants": "https://zenodo.org/api/records/24146126/access/grants", "access_users": "https://zenodo.org/api/records/24146126/access/users", "access_request": "https://zenodo.org/api/records/24146126/access/request", "access": "https://zenodo.org/api/records/24146126/access", "communities": "https://zenodo.org/api/records/24146126/communities", "communities-suggestions": "https://zenodo.org/api/records/24146126/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/24146126/request-deletion", "file_modification": "https://zenodo.org/api/records/24146126/file-modification", "quota_increase": "https://zenodo.org/api/records/24146126/quota-increase", "requests": "https://zenodo.org/api/records/24146126/requests"}, "updated": "2026-11-11T20:54:09.089123+00:00", "recid": "24146126", "revision": 3, "files": [{"id": "d24b1013-4e0d-4291-845d-cfde7ee86ca8", "key": "Foundation-0/gaia-dr4-v1.0.0.zip", "size": 35698, "checksum": "md5:6d8a3c23528bc2c5f97072c9207bf66e", "links": {"self": "https://zenodo.org/api/records/24146126/files/Foundation-0/gaia-dr4-v1.0.0.zip/content"}}], "swh": null, "owners": [{"id": "1936469"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 1, "unique_views": 1, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 1, "version_views": 1}, "state": "done", "submitted": true}, {"created": "2026-11-11T20:53:47.448696+00:00", "modified": "2026-11-11T20:53:47.661148+00:00", "id": 24146118, "conceptrecid": "24146117", "doi": "10.5281/zenodo.24146118", "conceptdoi": "10.5281/zenodo.24146117", "doi_url": "https://doi.org/10.5281/zenodo.24146118", "metadata": {"title": "plate-novae", "doi": "10.5281/zenodo.24146118", "publication_date": "2026-11-11", "description": "<p>This repository searches the Harvard DASCH plates (about 1890 to 1990) for earlier eruptions of known novae, which would show that a nova is recurrent.</p><p>Status: pilot, claimed, not peer reviewed. No person outside the project has checked it.</p><p>A pilot on five stars reports, as claimed and not checked by a person, that 5 of 17 known eruptions of T Pyx, U Sco and RS Oph from 1890 to 1989 were recovered (6 of 17 with a fainter quiet level). An RS Oph signal in March 1914 is an unverified flag, not a discovery.</p><p>As <a href=\"https://dasch.cfa.harvard.edu/citing/\">DASCH asks</a>: This work has made use of data provided by Digital Access to a Sky Century @ Harvard (DASCH), which has been partially supported by NSF grants AST-0407380, AST-0909073, and AST-1313370. Work on DASCH Data Release 7 received support from the Smithsonian American Women's History Initiative Pool.</p><p>Raw DASCH light curves are not redistributed here and are not in the archive. The scripts fetch them.</p><p>Directed by Ahraz Arifuddin</p><p>Researched and verified by different model families across Gemini, Claude, Grok, OpenAI, and Muse</p>", "access_right": "open", "creators": [{"name": "Arifuddin, Ahraz", "affiliation": null}], "keywords": ["astronomy", "dasch", "foundation0", "novae", "photographic-plates", "variable-stars"], "related_identifiers": [{"identifier": "https://github.com/Foundation-0/plate-novae", "relation": "isSupplementTo", "resource_type": "software", "scheme": "url"}], "version": "v1.0.0", "custom": {"code:codeRepository": "https://github.com/Foundation-0/plate-novae"}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "apache2.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "24146117"}}]}}, "title": "plate-novae", "links": {"self": "https://zenodo.org/api/records/24146118", "self_html": "https://zenodo.org/records/24146118", "preview_html": "https://zenodo.org/records/24146118?preview=1", "doi": "https://doi.org/10.5281/zenodo.24146118", "self_doi": "https://doi.org/10.5281/zenodo.24146118", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.24146118", "reserve_doi": "https://zenodo.org/api/records/24146118/draft/pids/doi", "parent": "https://zenodo.org/api/records/24146117", "parent_html": "https://zenodo.org/records/24146117", "parent_doi": "https://doi.org/10.5281/zenodo.24146117", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.24146117", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:24146118/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:24146118/sequence/default", "files": "https://zenodo.org/api/records/24146118/files", "media_files": "https://zenodo.org/api/records/24146118/media-files", "latest": "https://zenodo.org/api/records/24146118/versions/latest", "latest_html": "https://zenodo.org/records/24146118/latest", "versions": "https://zenodo.org/api/records/24146118/versions", "draft": "https://zenodo.org/api/records/24146118/draft", "access_links": "https://zenodo.org/api/records/24146118/access/links", "access_grants": "https://zenodo.org/api/records/24146118/access/grants", "access_users": "https://zenodo.org/api/records/24146118/access/users", "access_request": "https://zenodo.org/api/records/24146118/access/request", "access": "https://zenodo.org/api/records/24146118/access", "communities": "https://zenodo.org/api/records/24146118/communities", "communities-suggestions": "https://zenodo.org/api/records/24146118/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/24146118/request-deletion", "file_modification": "https://zenodo.org/api/records/24146118/file-modification", "quota_increase": "https://zenodo.org/api/records/24146118/quota-increase", "requests": "https://zenodo.org/api/records/24146118/requests"}, "updated": "2026-11-11T20:53:47.661148+00:00", "recid": "24146118", "revision": 3, "files": [{"id": "6e7ef9d7-55d9-41cf-963f-bcac635c5628", "key": "Foundation-0/plate-novae-v1.0.0.zip", "size": 40426, "checksum": "md5:c7b614a6150c6d8ae0db5a2dfea81938", "links": {"self": "https://zenodo.org/api/records/24146118/files/Foundation-0/plate-novae-v1.0.0.zip/content"}}], "swh": null, "owners": [{"id": "1936469"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 2, "unique_views": 2, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 2, "version_views": 2}, "state": "done", "submitted": true}, {"created": "2026-11-11T21:11:13.933462+00:00", "modified": "2026-11-11T21:11:14.155732+00:00", "id": 24146360, "conceptrecid": "24146359", "doi": "10.5281/zenodo.24146360", "conceptdoi": "10.5281/zenodo.24146359", "doi_url": "https://doi.org/10.5281/zenodo.24146360", "metadata": {"title": "lost-eclipses", "doi": "10.5281/zenodo.24146360", "publication_date": "2026-11-11", "description": "<p>This repository will compare eclipsing binaries catalogued from old photographic plates with TESS light curves, flag stars whose eclipses have gone, and check the strongest cases on the old plates.</p><p>Status: not started. No flags or results from this project are present yet.</p><p>Directed by Ahraz Arifuddi